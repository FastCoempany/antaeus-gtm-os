+const TARGETS = ["src", "supabase/functions", "deliverables/room-capability-maps", "preview-transcript", "deliverables/design-principle-strict-bible/08-room-guardian-specs/antaeus-discovery-studio-capability-map-2026-07-07.html", "js/discovery-frameworks.js", "js/demo-seed-data-ent.js", "js/demo-seed-data-smb.js"];
+const esc = s => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
