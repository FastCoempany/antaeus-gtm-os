+        const state = [...preceding.matchAll(/<h[23]>([\s\S]*?)<\/h[23]>/g)].at(-1)?.[1] || "gate";
+        const context = stripTags(m[3]);
+        occurrences.push({
+            room,
+            state: stripTags(state),
+            elementType: m[1],
+            text,
+            renderContext: context,
